#!/usr/bin/env bash
#
# Stands in for docker on PATH, since the bats container has neither images
# nor a Docker socket. Logs every call to DOCKER_LOG, one call per line with
# the arguments joined by spaces, and succeeds without output.
#
# Set DOCKER_FAIL to make every call whose logged line contains that string
# fail the way a failing command in the container does.
#
# A call whose last argument is php -m prints the file DOCKER_PHP_MODULES names
# instead, and one whose last argument is php -r 'echo PHP_VERSION;' prints
# DOCKER_PHP_VERSION, without a newline, as PHP does.
#
# A buildx imagetools inspect call prints the file in DOCKER_INSPECT named
# after its last argument, the image reference, with every / and : turned into
# _, whatever its --format asks for. Without one it fails as a missing image
# does.
set -Eeuo pipefail

printf '%s\n' "$*" >> "${DOCKER_LOG:?}"

if [ -n "${DOCKER_FAIL:-}" ] && [[ "$*" == *"$DOCKER_FAIL"* ]]; then
	echo >&2 "fake docker: failing as DOCKER_FAIL='$DOCKER_FAIL' asks"
	exit 1
fi

case "${*: -1}" in
	'php -m') cat "${DOCKER_PHP_MODULES:?}" ;;
	"php -r 'echo PHP_VERSION;'") printf '%s' "${DOCKER_PHP_VERSION:?}" ;;
esac

case "$*" in
	'buildx imagetools inspect '*)
		ref="${*: -1}"
		fixture="${DOCKER_INSPECT:?}/${ref//[\/:]/_}"
		if [ ! -f "$fixture" ]; then
			echo >&2 "ERROR: $ref: not found (fake docker has no $fixture)"
			exit 1
		fi
		cat "$fixture"
		;;
esac
